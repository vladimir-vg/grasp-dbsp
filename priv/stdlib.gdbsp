# ===== Logic =====

std.not         :: function((enum("false","true")) -> enum("false","true"))
std.and         :: function((enum("false","true"), enum("false","true")) -> enum("false","true"))
std.or          :: function((enum("false","true"), enum("false","true")) -> enum("false","true"))

# ===== String =====

std.string_length      :: function((string("UTF-8")) -> integer)
std.string_upper       :: function((string("UTF-8")) -> string("UTF-8"))
std.string_lower       :: function((string("UTF-8")) -> string("UTF-8"))
std.string_trim        :: function((string("UTF-8")) -> string("UTF-8"))
std.string_ltrim       :: function((string("UTF-8")) -> string("UTF-8"))
std.string_rtrim       :: function((string("UTF-8")) -> string("UTF-8"))
std.string_starts_with :: function((string("UTF-8"), "prefix": string("UTF-8")) -> enum("false","true"))
std.string_ends_with   :: function((string("UTF-8"), "suffix": string("UTF-8")) -> enum("false","true"))
std.string_contains    :: function((string("UTF-8"), "sub": string("UTF-8")) -> enum("false","true"))
std.string_substring   :: function((string("UTF-8"), "start": i64) -> string("UTF-8"))
std.string_substring   :: function((string("UTF-8"), "start": i64, "length": i64) -> string("UTF-8"))
std.string_replace     :: function((string("UTF-8"), "from": string("UTF-8"), "to": string("UTF-8")) -> string("UTF-8"))
std.string_split       :: function((string("UTF-8"), "delimiter": string("UTF-8")) -> array(string("UTF-8")))
std.string_at          :: function((string("UTF-8"), i64) -> string("UTF-8"))
std.string_slice       :: function((string("UTF-8"), "start": i64, "stop": i64, "step": i64) -> string("UTF-8"))
std.string_slice       :: function((string("UTF-8"), "start": i64, "stop": i64) -> string("UTF-8"))
std.string_slice       :: function((string("UTF-8"), "stop": i64) -> string("UTF-8"))

std.string_eq  :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))
std.string_neq :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))
std.string_lt  :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))
std.string_gt  :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))
std.string_lte :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))
std.string_gte :: function((string("UTF-8"), string("UTF-8")) -> enum("false","true"))

# ===== Concat =====

std.concat_string :: function((string("UTF-8"), string("UTF-8")) -> string("UTF-8"))
std.concat_bytes  :: function((bytes, bytes) -> bytes)
std.concat_bits   :: function((bits, bits) -> bits)
std.concat_array  :: function((array(T), array(T)) -> array(T))

# ===== Bytes / Bits =====

std.bytes_size :: function((bytes) -> integer)
std.bytes_at   :: function((bytes, i64) -> i64)
std.bytes_slice :: function((bytes, "start": i64, "stop": i64, "step": i64) -> bytes)
std.bytes_slice :: function((bytes, "start": i64, "stop": i64) -> bytes)
std.bytes_slice :: function((bytes, "stop": i64) -> bytes)

std.bits_size   :: function((bits) -> integer)
std.bits_at     :: function((bits, i64) -> bits)
std.bits_slice  :: function((bits, "start": i64, "stop": i64, "step": i64) -> bits)
std.bits_slice  :: function((bits, "start": i64, "stop": i64) -> bits)
std.bits_slice  :: function((bits, "stop": i64) -> bits)

std.bits_and  :: function((bits, bits) -> bits)
std.bits_or   :: function((bits, bits) -> bits)
std.bits_xor  :: function((bits, bits) -> bits)
std.bits_not  :: function((bits) -> bits)
std.bits_shl  :: function((bits, integer) -> bits)
std.bits_shr  :: function((bits, integer) -> bits)
std.bits_rotl :: function((bits, integer) -> bits)
std.bits_rotr :: function((bits, integer) -> bits)

std.bytes_eq  :: function((bytes, bytes) -> enum("false","true"))
std.bytes_neq :: function((bytes, bytes) -> enum("false","true"))
std.bytes_lt  :: function((bytes, bytes) -> enum("false","true"))
std.bytes_gt  :: function((bytes, bytes) -> enum("false","true"))
std.bytes_lte :: function((bytes, bytes) -> enum("false","true"))
std.bytes_gte :: function((bytes, bytes) -> enum("false","true"))

std.bits_eq  :: function((bits, bits) -> enum("false","true"))
std.bits_neq :: function((bits, bits) -> enum("false","true"))
std.bits_lt  :: function((bits, bits) -> enum("false","true"))
std.bits_gt  :: function((bits, bits) -> enum("false","true"))
std.bits_lte :: function((bits, bits) -> enum("false","true"))
std.bits_gte :: function((bits, bits) -> enum("false","true"))

# ===== Map =====

std.map_size   :: function((map(K, V)) -> integer)
std.map_keys   :: function((map(K, V)) -> array(K))
std.map_values :: function((map(K, V)) -> array(V))
std.map_has    :: function((map(K, V), "key": K) -> enum("false","true"))
std.map_get    :: function((map(K, V), "key": K) -> V)
std.map_without :: function((map(K, V), "keys": array(K)) -> map(K, V))
std.map_merge  :: function((map(K, V), map(K, V)) -> map(K, V))

# ===== Array =====

std.array_size    :: function((array(T)) -> integer)
std.array_append  :: function((array(T), T) -> array(T))
std.array_prepend :: function((T, array(T)) -> array(T))
std.array_contains :: function((array(T), T) -> enum("false","true"))
std.array_reverse :: function((array(T)) -> array(T))
std.array_sort    :: function((array(T)) -> array(T))
std.array_at      :: function((array(T), i64) -> T)
std.array_slice   :: function((array(T), "start": i64, "stop": i64, "step": i64) -> array(T))
std.array_slice   :: function((array(T), "start": i64, "stop": i64) -> array(T))
std.array_slice   :: function((array(T), "stop": i64) -> array(T))

# ===== Temporal =====

std.date     :: function((timestamp) -> date)
std.time     :: function((timestamp) -> time)
std.timestamp :: function((i64) -> timestamp)

# ===== Math helpers =====

std.abs_i64     :: function((i64) -> i64)
std.abs_f64     :: function((f64) -> f64)
std.abs_numeric :: function((numeric) -> numeric)

std.sign_i64     :: function((i64) -> i64)
std.sign_f64     :: function((f64) -> i64)
std.sign_numeric :: function((numeric) -> integer)

std.sqrt_f64   :: function((f64) -> f64)

std.pow_f64 :: function((f64, f64) -> f64)
std.ln_f64  :: function((f64) -> f64)
std.log_f64 :: function((f64, "base": f64) -> f64)

std.ceil_f64      :: function((f64) -> i64)
std.floor_f64     :: function((f64) -> i64)
std.round_f64     :: function((f64) -> i64)
std.ceil_numeric  :: function((numeric) -> integer)
std.floor_numeric :: function((numeric) -> integer)
std.round_numeric :: function((numeric) -> integer)

std.is_nan      :: function((f64) -> enum("false","true"))
std.is_infinite :: function((f64) -> enum("false","true"))
std.is_finite   :: function((f64) -> enum("false","true"))

# ===== Struct =====

# Note: key argument must be a compile-time constant string("UTF-8") literal.
# Non-literal keys result in a compile error.
std.struct_get :: function((S, "key": string("UTF-8")) -> V)

# Update-only: key must name an existing field; value type must match the
# field's declared type. Output type is S unchanged.
std.struct_set :: function((S, "key": string("UTF-8"), "value": V) -> S)

# ===== Aggregates =====

std.agg_sum_i64      :: aggregate_function((i64) -> i64)
std.agg_sum_numeric  :: aggregate_function((numeric) -> numeric)
std.agg_sum_f64      :: aggregate_function((f64) -> f64)
std.agg_count        :: aggregate_function(() -> i64)
std.agg_avg_i64      :: aggregate_function((i64) -> f64)
std.agg_avg_numeric  :: aggregate_function((numeric) -> numeric)
std.agg_avg_f64      :: aggregate_function((f64) -> f64)
std.agg_min_i64      :: aggregate_function((i64) -> i64)
std.agg_min_numeric  :: aggregate_function((numeric) -> numeric)
std.agg_min_f64      :: aggregate_function((f64) -> f64)
std.agg_max_i64      :: aggregate_function((i64) -> i64)
std.agg_max_numeric  :: aggregate_function((numeric) -> numeric)
std.agg_max_f64      :: aggregate_function((f64) -> f64)
std.agg_xor_bytes    :: aggregate_function((bytes) -> bytes)
