std.eq_boolean  :: function((enum("false","true"), enum("false","true")) -> enum("false","true"))
std.eq_bytes    :: function((bytes, bytes) -> enum("false","true"))
std.eq_bits     :: function((bits, bits) -> enum("false","true"))
std.eq_date     :: function((date, date) -> enum("false","true"))
std.eq_time     :: function((time, time) -> enum("false","true"))
std.eq_timestamp :: function((timestamp, timestamp) -> enum("false","true"))
std.eq_interval :: function((interval, interval) -> enum("false","true"))

